<UserControl x:Class="OpenDrop.WhatsNewPopup"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        <!-- The close lens: the same round glass button as the header's,
             sized down so it reads as a dismiss, not an action. -->
        <Style Selector="Button.close">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.FillFloat}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Edge}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.Tint}"/>
        </Style>
        <!-- A link inside the notes: accent, underlined, hand cursor. -->
        <Style Selector="TextBlock.note-link">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.note-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}"/>
        </Style>
    </UserControl.Styles>

    <!-- The whole control covers the window: a dimmed backdrop (click to
         dismiss) with the fixed-size notes card centred on top. The card
         NEVER grows with the notes: its body scrolls instead, so a long
         changelog cannot turn into a full-height list. -->
    <Grid x:Name="Root">
        <Border Background="#99000000" PointerPressed="Backdrop_PointerPressed"/>

        <Border x:Name="Card" Width="560" MaxHeight="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Window}"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.Glass.Rim}"
                BoxShadow="{DynamicResource Shadow.Card}"
                CornerRadius="18" Padding="20,16,20,16">
            <Border.Styles>
                <!-- Settle-in: a plain fade, so a short changelog keeps a
                     short card and a small window a small popup. -->
                <Style Selector="Border#Card">
                    <Style.Animations>
                        <Animation Duration="0:0:0.32" Easing="QuinticEaseOut" FillMode="Forward">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>

            <DockPanel LastChildFill="True">
                <!-- Header: version + title on the left, dismiss on the
                     right. No move, no resize - it is fixed by design. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextTitle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Classes="close" Click="Close_Click"
                            ToolTip.Tip="{DynamicResource WhatsNew.Close}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#10005;" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- The body: fixed height, scrolls. Links inside stay
                     clickable (open in the browser) and copyable (right
                     click -> copy link, tooltip shows the URL). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BlocksPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
