<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFramework>
    <RootNamespace>OpenDrop</RootNamespace>
    <AssemblyName>OpenDrop</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>bin\</BaseOutputPath>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationTitle>OpenDrop</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.16.1</Version>
    <AssemblyVersion>0.16.1.0</AssemblyVersion>
    <FileVersion>0.16.1.0</FileVersion>
    <DefineConstants Condition="'$(TargetFramework)' == 'net8.0-windows'">$(DefineConstants);WINDOWS_TARGET</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Remove="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon: read at runtime through avares:// -->
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled French translation of the What's-New notes: read at
         runtime through GetManifestResourceStream (WhatsNew.cs), its
         first line declaring the version it translates. The version
         bump rewrites it next to the changelog section.
         WithCulture=false: MSBuild's AssignCulture reads the ".fr." in
         the file name as a SATELLITE culture and would ship the file in
         fr\OpenDrop.resources.dll instead of the main assembly. -->
    <EmbeddedResource Include="whatsnew.fr.md" LogicalName="OpenDrop.whatsnew.fr.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\web\**" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
