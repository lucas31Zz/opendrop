<Window x:Class="OpenDrop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="420" Height="560"
        Background="#0f0f0f"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4a9eff"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.input">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button.save">
            <Setter Property="Background" Value="#4a9eff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="#3a8eef"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.browse:pointerover">
            <Setter Property="Background" Value="#444"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="?" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#4a9eff"/>
            <TextBlock Text="{DynamicResource Settings.Header}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- General -->
                <TextBlock Classes="section" Text="{DynamicResource Section.General}"/>

                <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.Language}"/>
                        <ComboBox x:Name="LanguageCombo" SelectedIndex="0" FontSize="13">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Français"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.ReceiveFolder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBlock x:Name="DownloadDirText" Text="Downloads/OpenDrop"
                                           FontSize="12" Foreground="#888" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                    Classes="browse" Click="BtnBrowseDownload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.ShareFolder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBlock x:Name="ShareDirText" Text="Downloads/OpenDrop/Partage"
                                           FontSize="12" Foreground="#888" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                    Classes="browse" Click="BtnBrowseShare_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.Port}"/>
                        <Border Classes="input">
                            <TextBox x:Name="PortBox" Text="8080" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <TextBlock Classes="section" Text="{DynamicResource Section.Storage}"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.GlobalQuota}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBox x:Name="QuotaBox" Text="0" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Quota.UnitHint}" Margin="8,0,0,0"
                                       FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Quota.NoUnitHint}"
                                   FontSize="11" Foreground="#555" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QuotaUsageText" Text="" FontSize="11" Foreground="#666"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Quota.CumulativeHint}"
                                   FontSize="11" Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Security -->
                <TextBlock Classes="section" Text="{DynamicResource Section.Security}"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Field.NewToken}"
                                   FontSize="13" Foreground="#ccc" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ToggleNewToken" IsChecked="False"
                                  Foreground="#4a9eff" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Network -->
                <TextBlock Classes="section" Text="{DynamicResource Section.Network}"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.NetworkInterface}"/>
                        <TextBlock x:Name="InterfaceText" Text="{DynamicResource Interface.Auto}"
                                   FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <TextBlock Classes="section" Text="{DynamicResource Section.Updates}"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Field.CheckUpdates}"
                                       FontSize="13" Foreground="#ccc" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="BtnCheckUpdates"
                                    Content="{DynamicResource Btn.Check}" Classes="browse"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Click="BtnCheckUpdates_Click"/>
                        </Grid>
                        <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11" Foreground="#666"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Appearance / Theme -->
                <TextBlock Classes="section" Text="{DynamicResource Section.Appearance}"/>
                <Border Classes="card" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Classes="field" Text="{DynamicResource Field.Theme}"/>
                        <ComboBox x:Name="ThemeCombo" FontSize="13" Margin="0,4,0,0"
                                  VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Border Width="12" Height="12" CornerRadius="3"
                                                Margin="0,0,8,0" VerticalAlignment="Center"
                                                Background="{Binding AccentBrush}"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="ThemeDescText" Text="" FontSize="11" Foreground="#666"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save button -->
        <Button Grid.Row="2" x:Name="BtnSave" Content="{DynamicResource Btn.Save}"
                HorizontalAlignment="Stretch" Classes="save"
                Click="BtnSave_Click"/>
    </Grid>
</Window>
