<Window x:Class="OpenDrop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="using:Avalonia.Animation.Easings"
        Title="{DynamicResource Settings.Title}"
        Width="420" Height="560"
        Background="{DynamicResource Surface.Window}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <!-- Same Liquid Glass card as the main window (see
             MainWindow.axaml): translucent pane over the aurora,
             bevelled rim, layered shadow with the specular top line. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.Fill}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Rim}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glass}"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Fields are pressed into the card rather than sitting on it:
             an inner shadow plus a hairline rim. -->
        <Style Selector="Border.input">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Recessed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rim}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Sidebar tabs: plain RadioButtons in one group, styled as a
             list rather than the stock TabControl, so every later visual
             pass only has to touch this one style. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.Fill}"/>
        </Style>
        <!-- The highlight itself lives on the pill that springs from tab
             to tab (see TabPill), so the checked background is left
             transparent instead of jumping there on its own. -->
        <Style Selector="RadioButton.tab:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.tab:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        </Style>
        <!-- The springing highlight is the accent-tinted glass of the
             active state, same language as the web tab indicator. -->
        <Style Selector="Border.tab-pill">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.Tint}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Save: the accent glass pill, twin of Button.accent in the
             main window. The hover swaps the gradient for a solid, so
             the two brushes are eased into each other. -->
        <Style Selector="Button.save">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.Accent}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.FillSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Edge}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.browse:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass.Fill}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Same aurora as the main window (see MainWindow.axaml): the
             glass needs colour behind it to have something to sit on.
             Motion.Apply in the code-behind strips these animations
             when the system asks for reduced motion - the blobs then
             keep these static margins. -->
        <Style Selector="Ellipse.aurora-1">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora1}"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="-130,-130,0,0"/>
            <Style.Animations>
                <Animation Duration="0:0:7" IterationCount="INFINITE"
                           PlaybackDirection="AlternateReverse" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="-130,-130,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="-60,-70,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-2">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora2}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,-120,-120,0"/>
            <Style.Animations>
                <Animation Duration="0:0:9" IterationCount="INFINITE"
                           PlaybackDirection="AlternateReverse" Easing="SineEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,-120,-120,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0,-60,-170,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-3">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora3}"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,0,-60,-160"/>
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE"
                           PlaybackDirection="AlternateReverse" Easing="QuadraticEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,0,-60,-160"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="-50,0,-10,-120"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Aurora: same wrapper as the main window (see MainWindow.axaml)
             - a full-span grid behind everything, so the blobs never take
             part in the row layout. Sized and placed to reach the corners
             of this smaller window; decorative and click-through. -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="-1" IsHitTestVisible="False">
            <Ellipse Classes="aurora-1" Width="340" Height="300"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-130,-130,0,0"/>
            <Ellipse Classes="aurora-2" Width="320" Height="290"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-120,-120,0"/>
            <Ellipse Classes="aurora-3" Width="380" Height="280"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,-60,-160"/>
        </Grid>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="?" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{DynamicResource Settings.Header}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextTitle}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content: tab list on the left, one visible page on the right.
             The window height is fixed, each page scrolls on its own. -->
        <Grid Grid.Row="1" x:Name="SettingsContent">
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Grid.RenderTransform>
            <Grid.Styles>
                <!-- The dialog settles in as it opens. -->
                <Style Selector="Grid#SettingsContent">
                    <Style.Animations>
                        <Animation Duration="0:0:0.45" Easing="QuinticEaseOut" FillMode="Forward">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="TranslateTransform.Y" Value="12"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="TranslateTransform.Y" Value="0"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Grid.Styles>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <!-- Highlight that springs from tab to tab (see
                     MoveTabPill in the code-behind). -->
                <Border x:Name="TabPill" Classes="tab-pill" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Height="0" Margin="0,0,0,0"/>

                <StackPanel x:Name="TabList">
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="general" IsChecked="True"
                                 Content="{DynamicResource Tab.General}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="storage"
                                 Content="{DynamicResource Tab.Storage}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="security"
                                 Content="{DynamicResource Tab.Security}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="network"
                                 Content="{DynamicResource Tab.Network}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="devices"
                                 Content="{DynamicResource Tab.Devices}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="appearance"
                                 Content="{DynamicResource Tab.Appearance}" Click="Tab_Click"/>
                    <RadioButton Classes="tab" GroupName="settings-tabs" Tag="updates"
                                 Content="{DynamicResource Tab.Updates}" Click="Tab_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Panel>

                    <!-- General -->
                    <StackPanel x:Name="TabGeneral">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Language}"/>
                                <ComboBox x:Name="LanguageCombo" SelectedIndex="0" FontSize="13">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.ReceiveFolder}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBlock x:Name="DownloadDirText" Text="Downloads/OpenDrop"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                            Classes="browse" Click="BtnBrowseDownload_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.ShareFolder}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBlock x:Name="ShareDirText" Text="Downloads/OpenDrop/Partage"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                            Classes="browse" Click="BtnBrowseShare_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Port}"/>
                                <Border Classes="input">
                                    <TextBox x:Name="PortBox" Text="8080" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Storage -->
                    <StackPanel x:Name="TabStorage" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.GlobalQuota}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBox x:Name="QuotaBox" Text="0" VerticalContentAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Quota.UnitHint}" Margin="8,0,0,0"
                                               FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Quota.NoUnitHint}"
                                           FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="QuotaUsageText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Quota.CumulativeHint}"
                                           FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Security -->
                    <StackPanel x:Name="TabSecurity" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Field.NewToken}"
                                           FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ToggleNewToken" IsChecked="False"
                                          Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel x:Name="TabNetwork" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.NetworkInterface}"/>
                                <TextBlock x:Name="InterfaceText" Text="{DynamicResource Interface.Auto}"
                                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Devices (pairing): token first, then the card the
                         phone scans (QR + link, rebuilt in code whenever
                         the token changes), then the registered devices.
                         Everything loads over HTTP from the Appareils tab
                         code-behind; the pair card is hidden while the
                         server is stopped. -->
                    <StackPanel x:Name="TabDevices" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Devices.Token}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBlock x:Name="DevicesToken" Text="" IsVisible="False"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" x:Name="BtnCopyToken" Content="{DynamicResource Btn.Copy}"
                                            Margin="8,0,0,0" Classes="browse" IsVisible="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pour parrainer : the QR is the pairing link
                             itself (the clean origin https://ip:port/
                             plus #pair=<device token>, no ?token= so
                             the page opens locked — see the PairLink
                             comment in code). The label lives in the
                             card so hiding the card on the stopped
                             state takes the whole section with it. -->
                        <Border x:Name="PairCard" Classes="card" Margin="0,0,0,12" IsVisible="False">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Devices.PourParrainer}"/>
                                <Image x:Name="PairQrImage" Width="160" Height="160"
                                       HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                <TextBlock x:Name="PairLinkText" Text=""
                                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnCopyLink" Content="{DynamicResource Btn.Copy}"
                                            Classes="browse" Margin="0,0,4,0" Padding="0,8"/>
                                    <Button Grid.Column="1" x:Name="BtnOpenLink" Content="{DynamicResource Devices.OpenBrowser}"
                                            Classes="browse" Margin="4,0,0,0" Padding="0,8"/>
                                </Grid>
                                <Button x:Name="BtnReset" Content="{DynamicResource Devices.Reset}"
                                        HorizontalAlignment="Stretch" Classes="browse" Padding="0,8"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Tab.Devices}"/>
                                <TextBlock x:Name="DevicesEmptyText" Text="{DynamicResource Devices.None}"
                                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"/>
                                <StackPanel x:Name="DevicesList"/>
                                <Button x:Name="BtnRefreshDevices" Content="{DynamicResource Btn.Refresh}"
                                        HorizontalAlignment="Stretch" Classes="browse"
                                        Margin="0,10,0,0" Padding="0,8"/>
                                <!-- Muted status line: stopped state, request
                                     failures. Empty while all is well. -->
                                <TextBlock x:Name="PairHintText" Text=""
                                           FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance: light / dark only -->
                    <StackPanel x:Name="TabAppearance" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Theme}"/>
                                <ComboBox x:Name="ThemeCombo" FontSize="13" Margin="0,4,0,0"
                                          SelectionChanged="ThemeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="TabUpdates" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Field.Version}"
                                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="VersionText" Text=""
                                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Button x:Name="BtnCheckUpdates" Content="{DynamicResource Btn.CheckUpdates}"
                                        HorizontalAlignment="Stretch" Classes="browse"
                                        Margin="0,10,0,0" Padding="0,8"
                                        Click="BtnCheckUpdates_Click"/>
                                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Panel>
            </ScrollViewer>
        </Grid>

        <!-- Save button -->
        <Button Grid.Row="2" x:Name="BtnSave" Content="{DynamicResource Btn.Save}"
                HorizontalAlignment="Stretch" Classes="save"
                Click="BtnSave_Click"/>
    </Grid>
</Window>
