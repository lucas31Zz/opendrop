<Window x:Class="OpenDrop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parametres OpenDrop"
        Width="420" Height="520"
        Background="#0f0f0f"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4a9eff"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.input">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button.save">
            <Setter Property="Background" Value="#4a9eff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="#3a8eef"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.browse:pointerover">
            <Setter Property="Background" Value="#444"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="?" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#4a9eff"/>
            <TextBlock Text="Parametres" FontSize="16" FontWeight="SemiBold" Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- General -->
                <TextBlock Classes="section" Text="GENERAL"/>
                <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Dossier de reception"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBlock x:Name="DownloadDirText" Text="Downloads/OpenDrop"
                                           FontSize="12" Foreground="#888" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                    Classes="browse" Click="BtnBrowseDownload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Dossier de partage"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBlock x:Name="ShareDirText" Text="Downloads/OpenDrop/Partage"
                                           FontSize="12" Foreground="#888" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                    Classes="browse" Click="BtnBrowseShare_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Port"/>
                        <Border Classes="input">
                            <TextBox x:Name="PortBox" Text="8080" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Stockage -->
                <TextBlock Classes="section" Text="STOCKAGE"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Quota global du dossier de reception"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Classes="input">
                                <TextBox x:Name="QuotaBox" Text="0" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Go ou Mo" Margin="8,0,0,0"
                                       FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Sans unite = Go : 500 vaut 500 Go, 500 mo vaut 500 Mo. 0 = illimite."
                                   FontSize="11" Foreground="#555" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QuotaUsageText" Text="" FontSize="11" Foreground="#666"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Taille cumulee des fichiers recus : un envoi qui ferait depasser le quota est refuse."
                                   FontSize="11" Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Security -->
                <TextBlock Classes="section" Text="SECURITE"/>
                <Border Classes="card" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nouveau token au demarrage"
                                   FontSize="13" Foreground="#ccc" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ToggleNewToken" IsChecked="False"
                                  Foreground="#4a9eff" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Network -->
                <TextBlock Classes="section" Text="RESEAU"/>
                <Border Classes="card" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Interface reseau"/>
                        <TextBlock x:Name="InterfaceText" Text="Detection automatique"
                                   FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save button -->
        <Button Grid.Row="2" x:Name="BtnSave" Content="Enregistrer"
                HorizontalAlignment="Stretch" Classes="save"
                Click="BtnSave_Click"/>
    </Grid>
</Window>
