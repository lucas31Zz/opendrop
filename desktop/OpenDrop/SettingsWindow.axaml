<Window x:Class="OpenDrop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="420" Height="560"
        Background="{DynamicResource Surface.Window}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Card}"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Fields are pressed into the card rather than sitting on it:
             an inner shadow plus a hairline rim. -->
        <Style Selector="Border.input">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Recessed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rim}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.CardHover}"/>
        </Style>

        <!-- Sidebar tabs: plain RadioButtons in one group, styled as a
             list rather than the stock TabControl, so every later visual
             pass only has to touch this one style. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <Style Selector="Button.save">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.Accent}"/>
        </Style>
        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.browse:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pointer glow (see MainWindow): same patch, moved by
             GlowService, showing through the gaps between the cards. -->
        <Border x:Name="GlowLayer" Grid.Row="1" IsHitTestVisible="False" IsVisible="False"
                Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource Glow.Ambient}"/>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="?" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{DynamicResource Settings.Header}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextTitle}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content: tab list on the left, one visible page on the right.
             The window height is fixed, each page scrolls on its own. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="general" IsChecked="True"
                             Content="{DynamicResource Tab.General}" Click="Tab_Click"/>
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="storage"
                             Content="{DynamicResource Tab.Storage}" Click="Tab_Click"/>
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="security"
                             Content="{DynamicResource Tab.Security}" Click="Tab_Click"/>
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="network"
                             Content="{DynamicResource Tab.Network}" Click="Tab_Click"/>
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="appearance"
                             Content="{DynamicResource Tab.Appearance}" Click="Tab_Click"/>
                <RadioButton Classes="tab" GroupName="settings-tabs" Tag="updates"
                             Content="{DynamicResource Tab.Updates}" Click="Tab_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Panel>

                    <!-- General -->
                    <StackPanel x:Name="TabGeneral">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Language}"/>
                                <ComboBox x:Name="LanguageCombo" SelectedIndex="0" FontSize="13">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.ReceiveFolder}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBlock x:Name="DownloadDirText" Text="Downloads/OpenDrop"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                            Classes="browse" Click="BtnBrowseDownload_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.ShareFolder}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBlock x:Name="ShareDirText" Text="Downloads/OpenDrop/Partage"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="..." Margin="8,0,0,0"
                                            Classes="browse" Click="BtnBrowseShare_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Port}"/>
                                <Border Classes="input">
                                    <TextBox x:Name="PortBox" Text="8080" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Storage -->
                    <StackPanel x:Name="TabStorage" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.GlobalQuota}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="input">
                                        <TextBox x:Name="QuotaBox" Text="0" VerticalContentAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Quota.UnitHint}" Margin="8,0,0,0"
                                               FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Quota.NoUnitHint}"
                                           FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="QuotaUsageText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Quota.CumulativeHint}"
                                           FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Security -->
                    <StackPanel x:Name="TabSecurity" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Field.NewToken}"
                                           FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ToggleNewToken" IsChecked="False"
                                          Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel x:Name="TabNetwork" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.NetworkInterface}"/>
                                <TextBlock x:Name="InterfaceText" Text="{DynamicResource Interface.Auto}"
                                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance: light / dark only -->
                    <StackPanel x:Name="TabAppearance" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Theme}"/>
                                <ComboBox x:Name="ThemeCombo" FontSize="13" Margin="0,4,0,0"
                                          SelectionChanged="ThemeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Classes="field" Text="{DynamicResource Field.Effects}"/>
                                <CheckBox x:Name="ToggleEffects" IsChecked="True" FontSize="13"
                                          Content="{DynamicResource Field.EffectsLabel}"
                                          Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{DynamicResource Field.EffectsHint}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextDim}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="TabUpdates" IsVisible="False">
                        <Border Classes="card" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Field.Version}"
                                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="VersionText" Text=""
                                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Button x:Name="BtnCheckUpdates" Content="{DynamicResource Btn.CheckUpdates}"
                                        HorizontalAlignment="Stretch" Classes="browse"
                                        Margin="0,10,0,0" Padding="0,8"
                                        Click="BtnCheckUpdates_Click"/>
                                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextFaint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Panel>
            </ScrollViewer>
        </Grid>

        <!-- Save button -->
        <Button Grid.Row="2" x:Name="BtnSave" Content="{DynamicResource Btn.Save}"
                HorizontalAlignment="Stretch" Classes="save"
                Click="BtnSave_Click"/>
    </Grid>
</Window>
