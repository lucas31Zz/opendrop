<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main window -->
    <x:String x:Key="Status.Starting">Démarrage...</x:String>
    <x:String x:Key="Status.Running">Serveur actif</x:String>
    <x:String x:Key="Status.Stopped">Serveur arrêté</x:String>
    <x:String x:Key="Status.Error">Erreur</x:String>
    <x:String x:Key="Btn.StartServer">Démarrer le serveur</x:String>
    <x:String x:Key="Btn.StopServer">Arrêter le serveur</x:String>
    <x:String x:Key="Btn.Settings">Paramètres</x:String>
    <x:String x:Key="Btn.Save">Enregistrer</x:String>
    <x:String x:Key="Btn.Saved">Enregistré !</x:String>
    <x:String x:Key="Btn.Reset">Réinitialiser</x:String>
    <x:String x:Key="Btn.Discord">Rejoindre le Discord d'OpenDrop</x:String>
    <x:String x:Key="Label.ServerAddress">ADRESSE DU SERVEUR</x:String>
    <x:String x:Key="Label.QrCode">QR CODE</x:String>
    <x:String x:Key="Qr.HintStart">Démarrez le serveur pour générer le QR code</x:String>
    <x:String x:Key="Qr.Unavailable">QR code indisponible</x:String>
    <x:String x:Key="Qr.Generating">Génération d'un nouveau token...</x:String>
    <x:String x:Key="Qr.Restarting">Redémarrage du serveur...</x:String>
    <x:String x:Key="Label.SessionCode">CODE DE SESSION</x:String>
    <x:String x:Key="Session.Hint">À saisir sur l'autre appareil quand la session est verrouillée.</x:String>
    <x:String x:Key="Label.TokenRefresh">RAFRAÎCHISSEMENT DU TOKEN</x:String>
    <x:String x:Key="Token.Never">Jamais</x:String>
    <x:String x:Key="Token.5m">5 minutes</x:String>
    <x:String x:Key="Token.15m">15 minutes</x:String>
    <x:String x:Key="Token.30m">30 minutes</x:String>
    <x:String x:Key="Token.1h">1 heure</x:String>
    <x:String x:Key="Token.NextRefresh">Prochain rafraîchissement dans</x:String>
    <x:String x:Key="Label.Folders">DOSSIERS</x:String>
    <x:String x:Key="Folders.Received">Reçus :</x:String>
    <x:String x:Key="Folders.Shared">Partagés :</x:String>
    <x:String x:Key="Folders.Missing">Ce dossier n'existe pas : {0}</x:String>
    <x:String x:Key="Label.ReceiveQuota">QUOTA DE RÉCEPTION</x:String>
    <x:String x:Key="Quota.Analyzing">Analyse...</x:String>
    <x:String x:Key="Quota.Description">Dossier de réception actuel, mis à jour automatiquement.</x:String>
    <x:String x:Key="Quota.Usage">Actuellement reçu : {0} dans ce dossier</x:String>
    <x:String x:Key="Quota.NoFiles">Aucun fichier reçu dans ce dossier pour l'instant</x:String>
    <x:String x:Key="Quota.Scanning">Analyse du dossier...</x:String>
    <x:String x:Key="Quota.Unlimited">{0} reçus (illimité)</x:String>
    <x:String x:Key="Quota.UsageInFolder">{0} reçus dans ce dossier</x:String>
    <x:String x:Key="Err.CannotStart">Impossible de démarrer le serveur.</x:String>
    <x:String x:Key="Err.CannotRestart">Impossible de redémarrer le serveur.</x:String>
    <x:String x:Key="Err.Settings">Erreur Paramètres :</x:String>
    <x:String x:Key="Err.Prefix">Erreur :</x:String>

    <!-- Settings window -->
    <x:String x:Key="Settings.Title">Paramètres OpenDrop</x:String>
    <x:String x:Key="Settings.Header">Paramètres</x:String>
    <x:String x:Key="Section.General">GÉNÉRAL</x:String>
    <x:String x:Key="Section.Storage">STOCKAGE</x:String>
    <x:String x:Key="Section.Security">SÉCURITÉ</x:String>
    <x:String x:Key="Section.Network">RÉSEAU</x:String>

    <!-- Onglets latéraux des paramètres -->
    <x:String x:Key="Tab.General">Général</x:String>
    <x:String x:Key="Tab.Storage">Stockage</x:String>
    <x:String x:Key="Tab.Security">Sécurité</x:String>
    <x:String x:Key="Tab.Network">Réseau</x:String>
    <x:String x:Key="Tab.Appearance">Apparence</x:String>
    <x:String x:Key="Tab.Updates">Mises à jour</x:String>
    <x:String x:Key="Field.Language">Langue</x:String>
    <x:String x:Key="Field.ReceiveFolder">Dossier de réception</x:String>
    <x:String x:Key="Field.ShareFolder">Dossier de partage</x:String>
    <x:String x:Key="Field.Port">Port</x:String>
    <x:String x:Key="Field.GlobalQuota">Quota global du dossier de réception</x:String>
    <x:String x:Key="Quota.UnitHint">Go ou Mo</x:String>
    <x:String x:Key="Quota.NoUnitHint">Sans unité = Go : 500 vaut 500 Go, 500 mo vaut 500 Mo. 0 = illimité.</x:String>
    <x:String x:Key="Quota.CumulativeHint">Taille cumulée des fichiers reçus : un envoi qui ferait dépasser le quota est refusé.</x:String>
    <x:String x:Key="Field.NewToken">Nouveau token au démarrage</x:String>
    <x:String x:Key="Field.NetworkInterface">Interface réseau</x:String>
    <x:String x:Key="Interface.Auto">Détection automatique</x:String>
    <x:String x:Key="Browse.ReceiveTitle">Choisir le dossier de réception</x:String>
    <x:String x:Key="Browse.ShareTitle">Choisir le dossier de partage</x:String>
    <x:String x:Key="Quota.Invalid">Quota invalide : "{0}"&#10;&#10;Exemples acceptés : 0,5 go (512 mo), 500 mo, 10.75.&#10;Un nombre sans unité est compté en Go. 0 = illimité.</x:String>
    <x:String x:Key="Quota.BigTitle">Quota global important</x:String>
    <x:String x:Key="Quota.BigBody">Quota global de {0}&#10;&#10;Ce quota dépasse 20 % de l'espace libre sur ce disque ({1} libres).&#10;&#10;Des transferts successifs finiraient par saturer ce disque : la machine peut ralentir, voire ne plus pouvoir écrire (système, mises à jour, fichiers temporaires).&#10;&#10;À vos risques et périls : enregistrer quand même ?</x:String>

    <!-- Message boxes -->
    <x:String x:Key="Msg.Yes">Oui</x:String>
    <x:String x:Key="Msg.No">Non</x:String>
    <x:String x:Key="Msg.Ok">OK</x:String>
    <x:String x:Key="Msg.Cancel">Annuler</x:String>

    <!-- Zone de notification -->
    <x:String x:Key="Tray.Show">Afficher OpenDrop</x:String>
    <x:String x:Key="Tray.Quit">Quitter OpenDrop</x:String>

    <!-- Fichiers partagés -->
    <x:String x:Key="Label.SharedFiles">FICHIERS PARTAGÉS</x:String>
    <x:String x:Key="Btn.AddFiles">Ajouter des fichiers...</x:String>
    <x:String x:Key="Btn.Rename">Renommer</x:String>
    <x:String x:Key="Btn.Delete">Supprimer</x:String>
    <x:String x:Key="Btn.Refresh">Actualiser</x:String>
    <x:String x:Key="Btn.Open">Ouvrir</x:String>
    <x:String x:Key="Btn.PutBack">Remettre</x:String>
    <x:String x:Key="Files.Empty">Le dossier de partage est vide.</x:String>
    <x:String x:Key="Files.MissingFolder">Le dossier de partage n'existe pas. Choisissez-en un dans les Paramètres.</x:String>
    <x:String x:Key="Files.SelectOne">Sélectionnez exactement un fichier.</x:String>
    <x:String x:Key="Files.SelectAny">Sélectionnez au moins un fichier.</x:String>
    <x:String x:Key="Files.RenameTitle">Renommer</x:String>
    <x:String x:Key="Files.RenamePrompt">Nouveau nom :</x:String>
    <x:String x:Key="Files.RenameInvalid">Ce nom ne peut pas être utilisé sur ce système.</x:String>
    <x:String x:Key="Files.RenameExists">Un fichier porte déjà ce nom.</x:String>
    <x:String x:Key="Files.RenameBatchPrompt">Nouveau nom de base pour les {0} fichiers sélectionnés.&#10;&#10;Ils sont numérotés dans l'ordre : nom, nom (2), nom (3)... Chaque fichier conserve sa propre extension.</x:String>
    <x:String x:Key="Files.RenameBatchFailed">{0} fichier(s) n'ont pas pu être renommés.</x:String>
    <x:String x:Key="Files.DeleteTitle">Suppression</x:String>
    <x:String x:Key="Files.DeleteConfirm">Supprimer {0} fichier(s) ?&#10;&#10;{1}&#10;&#10;Les fichiers sont retirés du disque.</x:String>
    <x:String x:Key="Files.DeleteFailed">{0} fichier(s) n'ont pas pu être supprimés.</x:String>
    <x:String x:Key="Files.AddTitle">Ajouter des fichiers au dossier de partage</x:String>
    <x:String x:Key="Files.CopyOrMove">Les copier dans le dossier de partage, ou les y déplacer ?&#10;&#10;Déplacer retire l'original de son dossier actuel.</x:String>
    <x:String x:Key="Files.Copy">Copier</x:String>
    <x:String x:Key="Files.Move">Déplacer</x:String>
    <x:String x:Key="Files.Adding">Ajout des fichiers...</x:String>
    <x:String x:Key="Files.AddFailed">{0} ajouté(s), {1} en échec.</x:String>
    <x:String x:Key="Files.AddSkipped">{0} ajouté(s), {1} déjà dans le dossier de partage.</x:String>
    <x:String x:Key="Files.NotFound">Ce fichier n'est plus dans le dossier de partage.</x:String>
    <x:String x:Key="Files.PutBackTitle">Remettre</x:String>
    <x:String x:Key="Files.PutBackConfirm">Remettre {0} dans son dossier d'origine ?&#10;&#10;{1}</x:String>

    <!-- Server manager -->
    <x:String x:Key="Sm.ProjectNotFound">Impossible de trouver le projet OpenDrop.</x:String>
    <x:String x:Key="Sm.NoPython">Python introuvable. Installez Python 3.10+ puis pip install qrcode cryptography.</x:String>
    <x:String x:Key="Sm.Timeout">Délai dépassé : le serveur n'a pas répondu.</x:String>
    <x:String x:Key="Sm.Exited">Le serveur Python s'est arrêté immédiatement.</x:String>

    <!-- Apparence -->
    <x:String x:Key="Section.Appearance">APPARENCE</x:String>
    <x:String x:Key="Field.Theme">Thème</x:String>
    <x:String x:Key="Theme.Light">Clair</x:String>
    <x:String x:Key="Theme.Dark">Sombre</x:String>

    <!-- Mises à jour -->
    <x:String x:Key="Section.Updates">MISES À JOUR</x:String>
    <x:String x:Key="Field.Version">Version</x:String>
    <x:String x:Key="Btn.CheckUpdates">Vérifier les mises à jour</x:String>
    <x:String x:Key="Update.Title">Mises à jour</x:String>
    <x:String x:Key="Up.Checking">Vérification des mises à jour...</x:String>
    <x:String x:Key="Up.UpToDate">OpenDrop est à jour ({0}).</x:String>
    <x:String x:Key="Up.Available">Une nouvelle version d'OpenDrop est disponible : {0} (vous avez {1}).</x:String>
    <x:String x:Key="Up.Skip">Ignorer cette version</x:String>
    <x:String x:Key="Up.Later">Plus tard</x:String>
    <x:String x:Key="Up.Install">Mettre à jour</x:String>
    <x:String x:Key="Up.Downloading">Téléchargement de {0}...</x:String>
    <x:String x:Key="Up.Installing">Installation...</x:String>
    <x:String x:Key="Up.Done">La mise à jour est en cours d'installation. OpenDrop va se fermer et redémarrer.</x:String>
    <x:String x:Key="Up.Error">Impossible de vérifier les mises à jour : {0}</x:String>
    <x:String x:Key="Up.InstallError">La mise à jour n'a pas pu être appliquée : {0}</x:String>
    <x:String x:Key="Up.InstallFailed">La mise à jour a échoué : le programme d'installation s'est arrêté avec le code {0}. OpenDrop n'a pas été mis à jour - vous pouvez réessayer depuis les Paramètres.</x:String>
    <x:String x:Key="Up.BadChecksum">le fichier téléchargé ne correspond pas à la somme de contrôle publiée</x:String>
    <x:String x:Key="Up.NoDigest">cette version ne publie aucune somme SHA-256 à vérifier pour le fichier</x:String>
    <x:String x:Key="Up.BadArchive">l'archive téléchargée n'est pas un paquet OpenDrop</x:String>
    <x:String x:Key="Up.NoPolkit">pkexec (polkit) est nécessaire pour installer dans /opt</x:String>

</ResourceDictionary>
