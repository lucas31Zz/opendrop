<Window x:Class="OpenDrop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="using:Avalonia.Animation.Easings"
        Title="OpenDrop"
        Width="880" Height="720"
        MinWidth="760" MinHeight="600"
        Background="{DynamicResource Surface.Window}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <!-- Lifted off the window: a wide soft shadow, a tighter one
                 for contact, and an inset highlight on the top edge. -->
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Card}"/>
        </Style>
        <!-- Same card while files are dragged over it: the accent outline
             says "drop here". -->
        <Style Selector="Border.card.dropping">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.subtle:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
        </Style>
        <Style Selector="Button.subtle:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The one button that carries the action gets a coloured
                 glow-shadow so it sits above the cards (a Button has no
                 BoxShadow in Avalonia, the effect is the equivalent). -->
            <Setter Property="Effect" Value="{DynamicResource Shadow.Accent}"/>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
        </Style>

        <!-- Wordmark: OPENDROP, one Border per letter so the hover is
             per-letter. Two stacked TextBlocks make the glow: the bottom
             one is the accent copy (softened by Shadow.Brand), the top
             one the readable text. Hovering a letter lifts it on a spring
             and blooms the halo underneath. -->
        <Style Selector="Border.brand-letter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.5">
                        <ThicknessTransition.Easing>
                            <anim:SpringEasing Mass="1" Stiffness="170" Damping="17"/>
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.brand-letter:pointerover">
            <Setter Property="Margin" Value="0,-5,0,5"/>
        </Style>
        <Style Selector="Border.brand-letter TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- The halo: a permanent faint glow that fills in on hover. -->
        <Style Selector="Border.brand-letter TextBlock.brand-glow">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.Brand}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.brand-letter:pointerover TextBlock.brand-glow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.brand-letter TextBlock.brand-text">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.brand-letter:pointerover TextBlock.brand-text">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTitle}"/>
        </Style>

        <!-- Scrollbar: no line buttons, a rounded track that only fades in
             while you scroll or hover, and a pill thumb that scales up and
             blooms its glow under the pointer (the fill itself comes from
             the palette re-pointed in App.axaml). -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="RadiusX" Value="4"/>
            <Setter Property="RadiusY" Value="4"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ScrollBar Thumb">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.Thumb}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28">
                        <TransformOperationsTransition.Easing>
                            <anim:SpringEasing Mass="1" Stiffness="170" Damping="17"/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <EffectTransition Property="Effect" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 12px is the width the 6px corner radius needs to read as a pill. -->
        <Style Selector="ScrollBar:vertical Thumb">
            <Setter Property="Width" Value="12"/>
        </Style>
        <Style Selector="ScrollBar:horizontal Thumb">
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="ScrollBar:vertical Thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.35,1)"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.ThumbHot}"/>
        </Style>
        <Style Selector="ScrollBar:horizontal Thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1,1.4)"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.ThumbHot}"/>
        </Style>

        <!-- Shared-files list -->
        <Style Selector="ListBox.filelist">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.filelist ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <!-- A row fades in when it appears (new file, refresh). -->
            <Style.Animations>
                <Animation Duration="0:0:0.32" Easing="QuinticEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBox.filelist ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
        </Style>
        <Style Selector="TextBlock.filename">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.filesize">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
        </Style>
        <Style Selector="Button.small:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <!-- Status and hint colours: switched from code by class, so the
             palette can follow the light/dark variant. -->
        <Style Selector="Ellipse.state-starting">
            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="Ellipse.state-running">
            <Setter Property="Fill" Value="#4caf50"/>
        </Style>
        <Style Selector="Ellipse.state-stopped">
            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="Ellipse.state-error">
            <Setter Property="Fill" Value="#f44336"/>
        </Style>
        <Style Selector="TextBlock.state-starting">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.state-running">
            <Setter Property="Foreground" Value="#4caf50"/>
        </Style>
        <Style Selector="TextBlock.state-stopped">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.state-error">
            <Setter Property="Foreground" Value="#f44336"/>
        </Style>
        <Style Selector="TextBlock.hint-muted">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.hint-danger">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </Style>
        <Style Selector="TextBlock.hint-error">
            <Setter Property="Foreground" Value="#f44336"/>
        </Style>
        <Style Selector="TextBlock.hint-success">
            <Setter Property="Foreground" Value="#4caf50"/>
        </Style>

        <!-- Quota bar: the width transition is what makes the fill glide
             to its new value instead of jumping there. With no limit
             configured the bar sweeps instead: there is no percentage to
             show, but the panel is never empty. -->
        <Style Selector="Border.quota-track">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.quota-fill">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.9">
                        <DoubleTransition.Easing>
                            <anim:QuinticEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.quota-fill.full">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        </Style>
        <Style Selector="Border.quota-fill.indeterminate">
            <Style.Animations>
                <Animation Duration="0:0:1.7" IterationCount="INFINITE"
                           Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="-80,0,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="460,0,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Aurora blobs: fill comes from the palette, motion from the
             slow drift below (each blob moves on its own path).
             The keyframes move the Margin, not a transform: a full
             Thickness is what the animation interpolates directly, and
             the travel has to be a visible share of the window or the
             drift reads as "motionless" (0.2px in the first seconds of a
             34s cycle). -->
        <Style Selector="Ellipse.aurora-1">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora1}"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Style.Animations>
                <Animation Duration="0:0:12" IterationCount="INFINITE"
                           PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="-220,-260,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="-110,-170,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-2">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora2}"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Style.Animations>
                <Animation Duration="0:0:14" IterationCount="INFINITE"
                           PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,-240,-240,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0,-150,-130,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-3">
            <Setter Property="Fill" Value="{DynamicResource Brush.Aurora3}"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Style.Animations>
                <Animation Duration="0:0:13" IterationCount="INFINITE"
                           PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,0,-80,-330"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="90,0,-170,-260"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The native window chrome already carries the name and the
             window buttons, so this strip only puts the icons (logo,
             theme, Discord) on the app itself: no background, no rim,
             nothing that cuts the window in two. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="28,16,28,12">
            <!-- The wordmark: one hover target per letter, each letter
                 sitting on its own blurred accent copy (the halo). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="4,0,0,0">
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="O"/><TextBlock Classes="brand-text" Text="O"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="P"/><TextBlock Classes="brand-text" Text="P"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="E"/><TextBlock Classes="brand-text" Text="E"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="N"/><TextBlock Classes="brand-text" Text="N"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="D"/><TextBlock Classes="brand-text" Text="D"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="R"/><TextBlock Classes="brand-text" Text="R"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="O"/><TextBlock Classes="brand-text" Text="O"/></Grid>
                </Border>
                <Border Classes="brand-letter">
                    <Grid><TextBlock Classes="brand-glow" Text="P"/><TextBlock Classes="brand-text" Text="P"/></Grid>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnTheme" Classes="icon"
                    ToolTip.Tip="{DynamicResource Btn.Theme}"
                    Click="BtnTheme_Click" VerticalAlignment="Center"
                    Margin="0,0,8,0">
                <TextBlock x:Name="ThemeGlyph" Text="&#9788;" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Grid.Column="2" x:Name="BtnDiscord" Classes="icon"
                    ToolTip.Tip="{DynamicResource Btn.Discord}"
                    Click="BtnDiscord_Click" VerticalAlignment="Center">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="#5865F2"
                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.157 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </Button>
        </Grid>

        <!-- Aurora: three soft blobs drifting behind everything, sized
             and placed to reach the corners of the window so no strip of
             the background falls back to the flat gradient. They are pure
             decoration: no hit-testing, no effect on layout (their
             position lives in the Margin the styles animate above). -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="-1" IsHitTestVisible="False">
            <Ellipse Classes="aurora-1" Width="680" Height="600"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-220,-260,0,0"/>
            <Ellipse Classes="aurora-2" Width="640" Height="580"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-240,0"/>
            <Ellipse Classes="aurora-3" Width="800" Height="560"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,-80,-330"/>
        </Grid>

        <!-- Content: server status on the left, shared files on the right -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="28,0,28,24">
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Grid.RenderTransform>
            <Grid.Styles>
                <!-- The whole panel settles in when the window opens. -->
                <Style Selector="Grid#ContentGrid">
                    <Style.Animations>
                        <Animation Duration="0:0:0.55" Easing="QuinticEaseOut" FillMode="Forward">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="TranslateTransform.Y" Value="16"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="TranslateTransform.Y" Value="0"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Grid.Styles>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- No scroll-to-focus: the QR code appears after the first
                 layout pass and would drag the view down by itself. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          BringIntoViewOnFocusChange="False">
                <StackPanel>

                    <!-- Status -->
                    <Border Classes="card">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Classes="state-starting" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="{DynamicResource Status.Starting}" FontSize="14" Classes="state-starting" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Server address -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.ServerAddress}"/>
                            <TextBlock x:Name="AddressText" Text="---" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- QR Code -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.QrCode}"/>
                            <Border x:Name="QrBorder" Background="{DynamicResource Brush.QrCard}" CornerRadius="12" Padding="16"
                                    HorizontalAlignment="Center" IsVisible="False">
                                <Image x:Name="QrImage" Width="220" Height="220"/>
                            </Border>
                            <TextBlock x:Name="QrHint" Text="{DynamicResource Qr.HintStart}"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Session code -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.SessionCode}"/>
                            <TextBlock x:Name="SessionCodeText" Text="---" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center"/>
                            <!-- The code is what the phone asks for: one
                                 click and it is in the clipboard. -->
                            <Button Classes="small" x:Name="BtnCopyCode"
                                    Content="{DynamicResource Btn.Copy}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Click="BtnCopyCode_Click"/>
                            <TextBlock Text="{DynamicResource Session.Hint}"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Token refresh -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.TokenRefresh}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TokenIntervalCombo" Grid.Column="0"
                                          FontSize="13" SelectedIndex="0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="{DynamicResource Token.Never}"/>
                                    <ComboBoxItem Content="{DynamicResource Token.5m}"/>
                                    <ComboBoxItem Content="{DynamicResource Token.15m}"/>
                                    <ComboBoxItem Content="{DynamicResource Token.30m}"/>
                                    <ComboBoxItem Content="{DynamicResource Token.1h}"/>
                                </ComboBox>
                                <Button x:Name="BtnRefreshToken" Grid.Column="1" Content="{DynamicResource Btn.Reset}"
                                        Classes="subtle" Padding="16,8" FontSize="12"
                                        Click="BtnRefreshToken_Click"/>
                            </Grid>
                            <TextBlock x:Name="TokenCountdownText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Share/Download info -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.Folders}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Folders.Received}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadDirText" Grid.Column="1" Text="---" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="small" FontSize="11" Padding="8,4"
                                        Content="{DynamicResource Btn.Open}"
                                        Click="BtnOpenReceived_Click"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Folders.Shared}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ShareDirText" Grid.Column="1" Text="---" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="small" FontSize="11" Padding="8,4"
                                        Content="{DynamicResource Btn.Open}"
                                        Click="BtnOpenShared_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Receive quota -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{DynamicResource Label.ReceiveQuota}"/>
                            <TextBlock x:Name="QuotaStatusText" Text="{DynamicResource Quota.Analyzing}" FontSize="16"
                                       FontWeight="SemiBold" Classes="hint-muted"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <!-- The fill eases to its new value whenever the
                                 usage changes (see .quota-fill below). -->
                            <Border x:Name="QuotaTrack" Classes="quota-track" IsVisible="False"
                                    Background="{DynamicResource Brush.Control}">
                                <Border x:Name="QuotaFill" Classes="quota-fill"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Quota.Description}"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Shared files. Also the drop target for files dragged in
                 from the Explorer: they are copied into the share folder. -->
            <Border Grid.Column="2" Classes="card" Margin="0" VerticalAlignment="Stretch"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="SharedFiles_DragEnter"
                    DragDrop.DragOver="SharedFiles_DragOver"
                    DragDrop.DragLeave="SharedFiles_DragLeave"
                    DragDrop.Drop="SharedFiles_Drop">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Classes="label"
                               Text="{DynamicResource Label.SharedFiles}"/>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Classes="small" x:Name="BtnAddFiles" Content="{DynamicResource Btn.AddFiles}"
                                Click="BtnAddFiles_Click" Margin="0,0,6,6"/>
                        <Button Classes="small" Content="{DynamicResource Btn.Rename}"
                                Click="BtnRename_Click" Margin="0,0,6,6"/>
                        <Button Classes="small" Content="{DynamicResource Btn.Delete}"
                                Click="BtnDelete_Click" Margin="0,0,6,6"/>
                        <Button Classes="small" Content="{DynamicResource Btn.Refresh}"
                                Click="BtnRefreshFiles_Click" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <TextBlock DockPanel.Dock="Top" x:Name="FilesEmpty"
                               Text="{DynamicResource Files.Empty}" IsVisible="False"
                               FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"
                               Margin="0,4,0,0" HorizontalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="FilesPathText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FilesHint" Text="" FontSize="11" Classes="hint-danger"
                                   TextWrapping="Wrap" IsVisible="False" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <ListBox x:Name="FileList" Classes="filelist" SelectionMode="Multiple"
                                 FontSize="13" DoubleTapped="FileList_DoubleTapped"
                                 PointerPressed="FileList_PointerPressed"
                                 PointerMoved="FileList_PointerMoved"
                                 PointerReleased="FileList_PointerReleased"
                                 KeyDown="FileList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Classes="filename" Text="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="small" FontSize="11" Padding="8,4"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Content="{DynamicResource Btn.PutBack}"
                                            IsVisible="{Binding CanPutBack}"
                                            Tag="{Binding}" Click="BtnPutBack_Click"/>
                                    <TextBlock Grid.Column="2" Classes="filesize" Text="{Binding Size}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Rubber band drawn while the left button is dragged
                             over the empty area of the list (Windows-style
                             multi-selection). -->
                        <Rectangle x:Name="SelectionBand" IsVisible="False"
                                   IsHitTestVisible="False" Opacity="0.75"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   RadiusX="2" RadiusY="2" StrokeThickness="1"
                                   Fill="{DynamicResource Brush.AccentSoft}"
                                   Stroke="{DynamicResource Brush.Accent}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Margin="28,0,28,20" Width="460" HorizontalAlignment="Left">
            <Button x:Name="BtnToggleServer" Content="{DynamicResource Btn.StartServer}"
                    Classes="accent" HorizontalAlignment="Stretch"
                    Click="BtnToggleServer_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnSettings" Content="{DynamicResource Btn.Settings}"
                    Classes="subtle" HorizontalAlignment="Stretch"
                    Click="BtnSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
