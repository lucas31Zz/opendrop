<Window x:Class="OpenDrop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDrop"
        Width="500" Height="720"
        MinWidth="420" MinHeight="600"
        Background="#0f0f0f"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4a9eff"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.subtle:pointerover">
            <Setter Property="Background" Value="#3a3a3a"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#4a9eff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#3a8eef"/>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="#2a7edf"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#c0392b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#e74c3c"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Padding="20,12" Background="#0f0f0f">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OpenDrop" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,24" Width="440" HorizontalAlignment="Center">

                <!-- Status -->
                <Border Classes="card">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#888" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="{DynamicResource Status.Starting}" FontSize="14" Foreground="#aaa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Server address -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.ServerAddress}"/>
                        <TextBlock x:Name="AddressText" Text="---" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#4a9eff" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- QR Code -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.QrCode}"/>
                        <Border x:Name="QrBorder" Background="White" CornerRadius="12" Padding="16"
                                HorizontalAlignment="Center" IsVisible="False">
                            <Image x:Name="QrImage" Width="220" Height="220"/>
                        </Border>
                        <TextBlock x:Name="QrHint" Text="{DynamicResource Qr.HintStart}"
                                   FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Session code -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.SessionCode}"/>
                        <TextBlock x:Name="SessionCodeText" Text="---" FontSize="22" FontWeight="SemiBold"
                                   Foreground="#e0e0e0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Session.Hint}"
                                   FontSize="11" Foreground="#666" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Token refresh -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.TokenRefresh}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TokenIntervalCombo" Grid.Column="0"
                                      FontSize="13" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource Token.Never}"/>
                                <ComboBoxItem Content="{DynamicResource Token.5m}"/>
                                <ComboBoxItem Content="{DynamicResource Token.15m}"/>
                                <ComboBoxItem Content="{DynamicResource Token.30m}"/>
                                <ComboBoxItem Content="{DynamicResource Token.1h}"/>
                            </ComboBox>
                            <Button x:Name="BtnRefreshToken" Grid.Column="1" Content="{DynamicResource Btn.Reset}"
                                    Classes="subtle" Padding="16,8" FontSize="12"
                                    Click="BtnRefreshToken_Click"/>
                        </Grid>
                        <TextBlock x:Name="TokenCountdownText" Text="" FontSize="11" Foreground="#666"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Share/Download info -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.Folders}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Folders.Received}" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="DownloadDirText" Grid.Column="1" Text="---" FontSize="12"
                                       Foreground="#ccc" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Folders.Shared}" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="ShareDirText" Grid.Column="1" Text="---" FontSize="12"
                                       Foreground="#ccc" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Receive quota -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{DynamicResource Label.ReceiveQuota}"/>
                        <TextBlock x:Name="QuotaStatusText" Text="{DynamicResource Quota.Analyzing}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#666"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Quota.Description}"
                                   FontSize="11" Foreground="#666" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Margin="28,0,28,20" Width="440" HorizontalAlignment="Center">
            <Button x:Name="BtnToggleServer" Content="{DynamicResource Btn.StartServer}"
                    Classes="accent" HorizontalAlignment="Stretch"
                    Click="BtnToggleServer_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnSettings" Content="{DynamicResource Btn.Settings}"
                    Classes="subtle" HorizontalAlignment="Stretch"
                    Click="BtnSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
